# --- Cluster access (omit KRCI_KUBE_CONTEXT when running in-cluster) ---
KRCI_KUBE_CONTEXT=
KRCI_NAMESPACE=
# --- Portal (UI tests only; leave empty for an API-only run) ---
KRCI_PORTAL_URL=
KRCI_PORTAL_TOKEN=                # ServiceAccount token — the only supported auth strategy
# --- Git ---
KRCI_GIT_SERVER=                  # GitServer CR name to test, e.g. gitlab
# Group/org path only: no scheme, no host (the GitServer CR carries gitHost), no
# leading or trailing slash, and no repo name — repos are named per test and
# appended as /<group>/<repo>. Nested groups (parent/team) are GitLab-only;
# GitHub and Bitbucket address repos as <owner>/<repo> and take a single segment.
KRCI_GIT_GROUP=                   # e.g. mygroup  |  mygroup/subgroup (GitLab)
# Gerrit projects are flat: leave KRCI_GIT_GROUP empty and repos are addressed as
# /<repo>. Only set KRCI_GIT_API_URL when the GitServer's host is unreachable from
# where the suite runs — Gerrit's gitHost is a cluster-internal service name, so a
# run from a laptop needs its external URL while a run inside the cluster does not.
KRCI_GIT_API_URL=                 # e.g. https://gerrit-<namespace>.<dns-wildcard>
# Import tests seed repos from public template tarballs on api.github.com.
# Anonymous fetches are capped (~60/hour/IP) — fine for a few cases, not for the
# import-matrix sweep. Any classic/fine-grained token with public-repo read works.
KRCI_GITHUB_TOKEN=
# --- TLS ---
KRCI_VERIFY_SSL=true              # false for self-signed environments
KRCI_CA_BUNDLE=                   # optional path to a CA bundle
# --- Run identity (optional; auto-generated when empty) ---
KRCI_RUN_ID=
# Wait tuning is NOT env config — it uses pytest's own option system (run knobs,
# not target facts). Override per run:  pytest -o krci_timeout_build_success=1800
# or in CI:  PYTEST_ADDOPTS="-o krci_timeout_build_success=1800"
# --- ReportPortal (optional; suite runs without RP when unset) ---
RP_ENDPOINT=
RP_PROJECT=
RP_API_KEY=
